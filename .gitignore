# Python
__pycache__/

# render_unit: node modules (npm install in render_unit/)
render_unit/node_modules/

# website/assets/ is in Git (an overwritten or deleted result can be restored from there); only what is temporary stays out:
# files that are written complete or not at all (<file>.part) and the list of pictures that failed
website/assets/**/*.part
render_errors.txt

# The full export of EVERY game version (units-<version>.json, about 15 MB) stays local, the base version's too: what is in Git is the reduced file of the base
# and the diff file of each later version (docs/versions.md). The page does not read the full file, and nothing here needs it but a render of the Raptor pictures.
website/assets/*/data/units-*.json
